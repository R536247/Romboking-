<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StudyRoomBooking</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Identity: users, roles, password hashing and cookie login stored with EF Core -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
    <!-- EF Core with SQLite: file-based database, no server needed -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Serilog: structured logging to console and rolling log files -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Known advisory in the native SQLite bundle used by EF Core (no patched 2.x version exists).
         Accepted for this locally run student project; explained in the documentation, section 6. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
