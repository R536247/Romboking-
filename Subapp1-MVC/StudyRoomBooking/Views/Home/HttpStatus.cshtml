@model int
@{
    var isNotFound = Model == 404;
    ViewData["Title"] = isNotFound ? "Page not found" : $"Error {Model}";
}
<section class="status-page">
    <p class="status-code">@Model</p>
    @if (isNotFound)
    {
        <h1>This page does not exist</h1>
        <p>The session or room may have been deleted, or the link is wrong.</p>
    }
    else
    {
        <h1>The request could not be completed</h1>
        <p>Go back and try again, or start from the front page.</p>
    }
    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a class="btn btn-ink" asp-controller="StudySession" asp-action="Index">See study sessions</a>
        <a class="btn btn-outline-ink" asp-controller="Home" asp-action="Index">Front page</a>
    </div>
</section>
