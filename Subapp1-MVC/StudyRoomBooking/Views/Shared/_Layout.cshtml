@{
    // Used to highlight the current section in the navbar
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string name) => controller == name ? "nav-link active" : "nav-link";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – StudyRoom</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true"><i class="bi bi-door-open-fill"></i></span>
                    StudyRoom
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="@NavClass("Home")" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="@(controller == "StudySession" && action != "Create" ? "nav-link active" : "nav-link")" asp-controller="StudySession" asp-action="Index">Study sessions</a></li>
                        <li class="nav-item"><a class="@NavClass("Room")" asp-controller="Room" asp-action="Index">Rooms</a></li>
                        @if (isLoggedIn)
                        {
                            <li class="nav-item"><a class="@NavClass("Profile")" asp-controller="Profile" asp-action="Index">My page</a></li>
                        }
                    </ul>

                    <div class="nav-actions">
                        <a class="btn btn-signal" asp-controller="StudySession" asp-action="Create">
                            <i class="bi bi-plus-lg me-1"></i>Book a room
                        </a>
                        @if (isLoggedIn)
                        {
                            <span class="nav-user">
                                <i class="bi bi-person-circle"></i> @User.Identity?.Name
                                @if (User.IsInRole(Roles.Admin))
                                {
                                    <span class="badge-admin">Admin</span>
                                }
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-nav">Log out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-nav" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-nav" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" class="container py-4 py-md-5">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            StudyRoom – study room booking for students. ITPE3200 group project, 2026.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
