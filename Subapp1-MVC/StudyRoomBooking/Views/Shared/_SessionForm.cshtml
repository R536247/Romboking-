@model StudySessionFormViewModel
@* Shared form for Create and Edit. The submit label and cancel target come from ViewData. *@
<form method="post" class="form-panel" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input type="hidden" asp-for="StudySessionId" />

    <fieldset>
        <legend>What you will study</legend>
        <div class="row g-3">
            <div class="col-sm-4">
                <label asp-for="CourseCode" class="form-label"></label>
                <input asp-for="CourseCode" class="form-control" placeholder="ITPE3200" />
                <span asp-validation-for="CourseCode" class="invalid-text"></span>
            </div>
            <div class="col-sm-8">
                <label asp-for="Subject" class="form-label"></label>
                <input asp-for="Subject" class="form-control" placeholder="Web Applications" />
                <span asp-validation-for="Subject" class="invalid-text"></span>
            </div>
            <div class="col-12">
                <label asp-for="Topic" class="form-label"></label>
                <input asp-for="Topic" class="form-control" placeholder="Exam prep, a lab, a chapter…" />
                <span asp-validation-for="Topic" class="invalid-text"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">Description <span class="optional">(optional)</span></label>
                <textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="What should people bring or prepare?"></textarea>
                <span asp-validation-for="Description" class="invalid-text"></span>
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>Where and when</legend>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="RoomId" class="form-label"></label>
                <select asp-for="RoomId" asp-items="Model.RoomOptions" class="form-select">
                    <option value="0">Choose a room</option>
                </select>
                <span asp-validation-for="RoomId" class="invalid-text"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" class="form-control" />
                <span asp-validation-for="StartTime" class="invalid-text"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="EndTime" class="form-label"></label>
                <input asp-for="EndTime" class="form-control" />
                <span asp-validation-for="EndTime" class="invalid-text"></span>
            </div>
            <div class="col-sm-4">
                <label asp-for="MaxParticipants" class="form-label"></label>
                <input asp-for="MaxParticipants" class="form-control" min="2" max="50" />
                <span asp-validation-for="MaxParticipants" class="invalid-text"></span>
            </div>
        </div>
    </fieldset>

    <div class="form-actions">
        <button type="submit" class="btn btn-ink">
            <i class="bi bi-check-lg me-1"></i>@ViewData["SubmitLabel"]
        </button>
        <a href="@ViewData["CancelUrl"]" class="btn btn-outline-ink">Cancel</a>
    </div>
</form>
