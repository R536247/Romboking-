@model StudySessionFormViewModel
@{
    ViewData["Title"] = "Book a room";
    ViewData["SubmitLabel"] = "Book room";
    ViewData["CancelUrl"] = Url.Action("Index");
}
<nav class="back-link"><a asp-action="Index"><i class="bi bi-arrow-left"></i> All study sessions</a></nav>
<div class="form-head">
    <h1>Book a room</h1>
    <p class="text-muted">You join the session automatically. Others can find it by course code and join you.</p>
</div>

<partial name="_SessionForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
