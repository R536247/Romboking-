@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}
<div class="auth-layout">
    <div class="auth-panel">
        <h1>Create account</h1>
        <p class="text-muted">Your name is shown to other students when you book or join a session.</p>

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" autocomplete="given-name" />
                <span asp-validation-for="DisplayName" class="invalid-text"></span>
            </div>
            <div class="mb-3">
                <label asp-for="StudyProgram" class="form-label">Study program <span class="optional">(optional)</span></label>
                <input asp-for="StudyProgram" class="form-control" placeholder="Information Technology" />
                <span asp-validation-for="StudyProgram" class="invalid-text"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="invalid-text"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span class="form-text">At least 8 characters, including a digit.</span>
                <span asp-validation-for="Password" class="invalid-text"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="invalid-text"></span>
            </div>
            <button type="submit" class="btn btn-ink w-100">Create account</button>
        </form>

        <p class="auth-switch">Already have an account? <a asp-action="Login">Log in</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
